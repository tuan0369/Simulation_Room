# Build context trimming. The repo is bind-mounted at runtime, so anything
# excluded here is still available to the running containers.
.git
.venv
venv

# Generated telemetry (regenerated by simulator/dataset_generator.py)
data/building_telemetry.csv
data/telemetry_raw/

# Large media that would balloon the build context (~120 MB of video)
report/

# Vendored browser libs are served by the room3d container from the bind mount
room3d/vendor/

**/__pycache__/
*.pyc
.pytest_cache/
ml/notebooks/.ipynb_checkpoints/

.playwright-mcp/
.DS_Store
